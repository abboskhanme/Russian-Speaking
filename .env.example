# ─────────────────────────────────────────────────────────────────────────────
# Govori — environment template.   cp .env.example .env
#
# Read by docker-compose.yml, which forwards these to the Api and Worker
# containers. Every key here is one the .NET backend actually reads; a variable
# that is not forwarded in compose reaches nothing, however correct it looks.
#
# ⚠ PRODUCTION: the Api REFUSES TO START when ASPNETCORE_ENVIRONMENT=Production
#   and any of SECRET_KEY / TELEGRAM_BOT_* / S3 credentials is still a default or
#   a placeholder. The refusal names every problem at once. See the
#   "Production hardening" section at the bottom.
# ─────────────────────────────────────────────────────────────────────────────

# ─── General ────────────────────────────────────────────────
# Development | Production. Production turns on the secret gate above, and is
# what the container images already set (see src/*/Dockerfile).
ASPNETCORE_ENVIRONMENT=Development

# JWT signing key — HS256 over the RAW UTF-8 BYTES of this string.
# ⚠ Anyone holding it can mint an access token for ANY user id, admins included.
# At least 32 characters, and never a value that has been in a repository:
#     openssl rand -base64 48
SECRET_KEY=change-me-in-production-use-a-long-random-string

# Cross-origin browsers allowed to call this API. Comma-separated ORIGINS —
# scheme://host[:port], no path, no wildcard.
#
# LEAVE EMPTY IN PRODUCTION. nginx serves the SPA and proxies /api + /hubs to the
# API on the same origin, so no CORS headers are needed and adding them only
# widens the surface. Set it only when the site and the API are on different
# origins (e.g. a local Vite dev server):
#     BACKEND_CORS_ORIGINS=http://localhost:5173
# A wildcard (*) is REFUSED at boot: this API is called with a bearer token, so
# "any site may read the response" is the whole of the damage.
BACKEND_CORS_ORIGINS=

# ─── Database (PostgreSQL) ──────────────────────────────────
# compose builds ConnectionStrings__Govori / GOVORI_DB from these three.
POSTGRES_USER=russpeak
POSTGRES_PASSWORD=russpeak
POSTGRES_DB=russpeak
# Host port for psql. 5433 is often taken by another project — the working dev
# value is 5434/5435; check before changing.
DB_PORT=5433

# ─── Redis ──────────────────────────────────────────────────
# OTP store (FAIL-CLOSED — a Redis outage denies logins, never approves them),
# SignalR backplane, Hangfire-adjacent caching and the rate-limit counters.
# The container address is fixed to redis:6379 by compose; nothing to set here.

# Rate-limit counter backend: `redis` (cross-instance, correct behind >1 API
# replica) or `memory` (per-process). compose defaults to redis.
GOVORI_RATELIMIT_BACKEND=redis

# ─── Object storage (S3-compatible; MinIO in dev) ───────────
# ⚠ EVERY recorded student answer and profile photo is behind these credentials.
# The stock `minioadmin` pair is refused in Production.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=govori-audio
# The host a BROWSER reaches MinIO on — presigned URLs are signed for it, so a
# wrong value yields links that 403. In prod this is the public S3/MinIO host.
S3_PUBLIC_URL=http://localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── Phone-OTP over a FREE Telegram bot ─────────────────────
# ⚠ THIS IS THE LOGIN. With BOTH values set the API mints a
# t.me/<username>?start=<token> deep link and the Worker's poller DMs the code.
#
# ⚠ With EITHER value missing the API falls back to DEV delivery, whose fixed
# code 000000 logs anyone in as ANY phone number. That is why Production refuses
# to start without them. Create the bot with @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ─── Auth ───────────────────────────────────────────────────
# Wire contract with tokens already in users' browsers and with the frontend's
# refresh logic. Changing a value changes how long every live session survives.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Verification-code behaviour (phone OTP).
EMAIL_OTP_LENGTH=6
EMAIL_OTP_TTL_SEC=600             # code lifetime in seconds (10 min)
EMAIL_OTP_MAX_ATTEMPTS=5          # wrong tries before the code is burned

# ─── Google Sign-In (optional) ──────────────────────────────
# OAuth 2.0 Web Client ID (https://console.cloud.google.com/apis/credentials).
# Used by BOTH backend (token verification) and frontend (button). Empty = off.
GOOGLE_CLIENT_ID=

# ─── AI providers ───────────────────────────────────────────
# These are DEFAULTS, not the last word: every key resolves as
#     app_settings override (admin panel) → this env var → built-in default
# so a key can be pasted or a chain reordered without a redeploy.
# An unset key is a SUPPORTED state — that backend is skipped and the chain
# moves on. If NO backend is configured the pipeline DEFERS (the attempt stays
# pending) rather than burning the student's attempt.

# Ordered provider chains. Empty = the built-in default order.
GRADER_CHAIN=
STT_CHAIN=

# Anthropic (Claude) — grader.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Google Gemini — grader. Free key: https://aistudio.google.com/apikey
# gemini-3.1-flash-lite ≈ 500 requests/day free (2.5-flash is only ~20/day).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI — grader backup AND the Whisper STT fallback (one key, both roles).
OPENAI_API_KEY=
OPENAI_GRADER_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1

# Azure AI Speech — the PRIMARY STT. The only backend that returns a
# pronunciation score, which is a fifth of the grade; without it grading
# degrades to four criteria. Portal → "Speech service" → KEY 1 + Region.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# Azure OpenAI — optional grader route (all four required together).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# ─── Feature flags (Faza 6) ─────────────────────────────────
# Both default OFF. Same resolution as the AI keys — an app_settings row wins —
# so a flag can be flipped from the admin panel without a redeploy.
REVIEW_DRILL_ENABLED=
ROLEPLAY_ENABLED=

# ─── Freemium ───────────────────────────────────────────────
# Within an official public module the first N tasks BY ORDER are free; the rest
# need premium. POSITIONAL, not a quota — it does not count attempts.
FREE_TASKS_PER_MODULE=3

# ─── Ports ──────────────────────────────────────────────────
API_PORT=8082
FRONTEND_PORT=8081

# ─── Observability ──────────────────────────────────────────
# OTLP collector endpoint (e.g. http://otel-collector:4317). Empty = disabled;
# the host never requires a collector to start. Metrics are always on /metrics.
OpenTelemetry__Otlp__Endpoint=

# ─── Production hardening ───────────────────────────────────
# With ASPNETCORE_ENVIRONMENT=Production the API validates its own configuration
# at boot and REFUSES TO START (exit code 1) if any of these is true:
#   • SECRET_KEY missing, under 32 chars, or still a placeholder;
#   • TELEGRAM_BOT_TOKEN / TELEGRAM_BOT_USERNAME missing (⇒ the 000000 bypass);
#   • object-storage credentials missing or stock (`minioadmin`);
#   • no database connection string;
#   • BACKEND_CORS_ORIGINS containing a wildcard or a non-origin value.
#
# Escape hatch — for running the PRODUCTION IMAGE LOCALLY to reproduce something,
# never on a public host. Leave empty everywhere else.
GOVORI_ALLOW_INSECURE_PRODUCTION=
