<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Govori.Contracts\Govori.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- S3-compatible object storage (MinIO in dev, S3/R2 in prod). -->
    <PackageReference Include="AWSSDK.S3" Version="3.7.511.8" />
    <!-- Redis-backed Telegram OTP deep-link store — shared by the API sender + Worker poller. -->
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <!-- The AI backends log by name when they fail, and reach vendors over pooled HttpClients
         (IHttpClientFactory) rather than one socket per grading run. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.23" />
    <!-- Claude: the official SDK, not hand-rolled HTTP — it owns the structured-output and
         refusal semantics that would otherwise be ours to track. -->
    <PackageReference Include="Anthropic" Version="12.40.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
