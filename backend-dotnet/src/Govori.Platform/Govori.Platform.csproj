<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Govori.Contracts\Govori.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- S3-compatible object storage (MinIO in dev, S3/R2 in prod). -->
    <PackageReference Include="AWSSDK.S3" Version="3.7.511.8" />
    <!-- Redis-backed Telegram OTP deep-link store — shared by the API sender + Worker poller. -->
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
