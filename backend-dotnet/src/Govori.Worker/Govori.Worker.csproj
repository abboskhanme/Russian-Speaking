<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Govori.Worker-e0edab3b-a67b-4d90-bd6e-b64910b6093e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.17" />
    <!-- Logging: Serilog structured JSON, same style as Govori.Api (docs/07 §7.3, §7.9) -->
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Worker IS the grading pipeline host (ex-Celery): it runs the Hangfire server + recurring
         maintenance jobs and publishes SignalR progress over the Redis backplane (docs/07 §7.7). -->
    <ProjectReference Include="..\Govori.Infrastructure\Govori.Infrastructure.csproj" />
    <ProjectReference Include="..\Govori.Platform\Govori.Platform.csproj" />
    <ProjectReference Include="..\Modules\Govori.Assessment\Govori.Assessment.csproj" />
    <ProjectReference Include="..\Govori.Realtime\Govori.Realtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- AddSignalR + IHubContext (for publishing progress via the backplane) come from the shared
         ASP.NET Core framework, usable from this generic Worker host once referenced. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
