    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Govori.Worker-e0edab3b-a67b-4d90-bd6e-b64910b6093e</UserSecretsId>
