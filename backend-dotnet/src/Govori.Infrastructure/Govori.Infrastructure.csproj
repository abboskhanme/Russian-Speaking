<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Govori.Platform owns the ITelegramBindingStore CONTRACT (both hosts depend on it); this
         project owns the DbContext, so the EF-backed IMPLEMENTATION lives here. The arrow points
         Infrastructure→Platform and never back: Platform references only Govori.Contracts, so this
         edge is acyclic and leaves the "Platform never depends on a domain or a host" guardrail
         (Govori.ArchTests, BoundaryRuleTests rule 1) untouched. -->
    <ProjectReference Include="..\Govori.Platform\Govori.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <!-- Pin Relational to 9.0.4: EFCore.NamingConventions 9.0.0 otherwise drags in
         Relational 9.0.1, a silent downgrade below the Npgsql provider's 9.0.4 that
         breaks the native-enum mapping convention. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.4" />
    <PackageReference Include="EFCore.NamingConventions" Version="9.0.0" />
  </ItemGroup>

</Project>
