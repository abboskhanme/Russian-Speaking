<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\Govori.Contracts\Govori.Contracts.csproj" />
    <ProjectReference Include="..\..\Govori.Infrastructure\Govori.Infrastructure.csproj" />
    <!-- Provider seams (ISttProvider / IGraderProvider) + IObjectStorage live in Platform. -->
    <ProjectReference Include="..\..\Govori.Platform\Govori.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same shared-framework pattern as Govori.Identity: the module uses ILogger, DI
