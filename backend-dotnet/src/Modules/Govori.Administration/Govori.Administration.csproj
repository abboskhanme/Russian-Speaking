<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\Govori.Contracts\Govori.Contracts.csproj" />
    <ProjectReference Include="..\..\Govori.Infrastructure\Govori.Infrastructure.csproj" />
    <!-- NOTE (Administration→Identity boundary): deliberately NOT referenced, and nothing here needs
         it. Accounts are passwordless (phone + Telegram OTP), so creating a teacher is a plain row
         insert, and the one shared auth rule it does need — Uzbek phone normalisation — lives in
         Govori.Contracts (PhoneNumbers) precisely so modules and hosts can use it without an edge
         into Identity. -->
  </ItemGroup>

  <ItemGroup>
    <!-- This module defines its own minimal-API endpoint group (MapAdministrationEndpoints) and uses
         ClaimsPrincipal / Results / IConfiguration / IMemoryCache-style types — the shared ASP.NET
         Core framework provides those to a class library. Same modular-endpoint pattern as
         Govori.Identity / Govori.Catalog / Govori.Practice / Govori.Classroom / Govori.Engagement. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.23" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
