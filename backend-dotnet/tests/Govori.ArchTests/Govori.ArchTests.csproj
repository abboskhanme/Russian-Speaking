<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- ArchTests must load EVERY inspected assembly by type, so it references the whole graph.
         Order below mirrors docs/07 §7.2: hosts, shared kernel, Platform, then the 8 domain modules.
         These are inspection-only references; ArchTests contains no production code. -->
    <!-- Hosts -->
    <ProjectReference Include="..\..\src\Govori.Api\Govori.Api.csproj" />
    <ProjectReference Include="..\..\src\Govori.Worker\Govori.Worker.csproj" />
    <!-- Shared kernel + cross-cutting -->
    <ProjectReference Include="..\..\src\Govori.Contracts\Govori.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Govori.Infrastructure\Govori.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Govori.Platform\Govori.Platform.csproj" />
    <ProjectReference Include="..\..\src\Govori.Realtime\Govori.Realtime.csproj" />
    <!-- Domain modules (docs/07 §7.2 boundary subjects) -->
    <ProjectReference Include="..\..\src\Modules\Govori.Identity\Govori.Identity.csproj" />
    <ProjectReference Include="..\..\src\Modules\Govori.Catalog\Govori.Catalog.csproj" />
    <ProjectReference Include="..\..\src\Modules\Govori.Practice\Govori.Practice.csproj" />
    <ProjectReference Include="..\..\src\Modules\Govori.Assessment\Govori.Assessment.csproj" />
    <ProjectReference Include="..\..\src\Modules\Govori.Classroom\Govori.Classroom.csproj" />
    <ProjectReference Include="..\..\src\Modules\Govori.Engagement\Govori.Engagement.csproj" />
    <ProjectReference Include="..\..\src\Modules\Govori.Administration\Govori.Administration.csproj" />
    <ProjectReference Include="..\..\src\Modules\Govori.Billing\Govori.Billing.csproj" />
    <ProjectReference Include="..\..\src\Modules\Govori.Drills\Govori.Drills.csproj" />
  </ItemGroup>

</Project>
