<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <!-- The live-vendor smoke builds a real IHttpClientFactory; the backends take nothing else. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.23" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Govori.Identity\Govori.Identity.csproj" />
    <!-- ClassroomScoring is pure math over Submission entities, so it is unit-testable without a
         database. The FROZEN parts (RollingAvg/BestBand) stay pinned by the C3 characterization
         fixture; only the newer statistics are covered here. -->
    <ProjectReference Include="..\..\src\Modules\Govori.Classroom\Govori.Classroom.csproj" />
    <!-- The provider chain is pure routing over in-memory fakes — no vendor, no network — so the
         four rules it encodes (skip-unconfigured, fall-back-on-throw, rethrow-on-cancel,
         report-the-model-that-really-ran) are unit-testable and worth pinning here. -->
    <ProjectReference Include="..\..\src\Govori.Platform\Govori.Platform.csproj" />
    <!-- AiProbeService is pure routing over the same IGraderBackend/ISttBackend fakes the chain
         tests already use — no database, no vendor — so the rules it encodes (skipped is not
         failed; report the model that really answered) are unit-testable here. -->
    <ProjectReference Include="..\..\src\Modules\Govori.Administration\Govori.Administration.csproj" />
    <!-- The stub payment adapter is pure refusal — no database, no vendor, no network — and it is
         the thing every payment attempt actually meets while no merchant account exists, so its
         three "never succeeds" guarantees are pinned here. -->
    <ProjectReference Include="..\..\src\Modules\Govori.Billing\Govori.Billing.csproj" />
    <!-- The minimal-pair seed is pure content — no database, no vendor — and its IPA arrays are
         joined to Azure's scores by index, so an off-by-one here would print one sound's score under
         another sound's name. Those invariants are cheapest to pin right here. -->
    <ProjectReference Include="..\..\src\Modules\Govori.Drills\Govori.Drills.csproj" />
  </ItemGroup>

</Project>
