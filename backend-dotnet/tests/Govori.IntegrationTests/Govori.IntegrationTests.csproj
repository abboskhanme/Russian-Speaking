<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <!-- WebApplicationFactory<Program> host boot for the auth vertical slice (docs/07 §7.5). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.4" />
    <!-- SignalR client — connects a real HubConnection to /hubs/attempts over the TestServer to
         assert the attempt-progress event contract + ownership auth (docs/08 Faza 3.10). -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.21" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.4" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <!-- NO Testcontainers here, deliberately. Every project targets net9.0 while the host SDK is
         8.0, so the suite can only run inside mcr.microsoft.com/dotnet/sdk:9.0 — where a
         Testcontainers Postgres would need the Docker socket mounted and would then publish on a
         HOST port that `localhost` inside the test container does not resolve to. Isolation is
         provided instead by TestDatabase: a uniquely-named database created per run on the Postgres
         we already reach, migrated with this solution's own EF Core migrations and dropped on
         teardown. Full reasoning in TestDatabase.cs. -->
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Govori.Api\Govori.Api.csproj" />
    <ProjectReference Include="..\..\src\Govori.Infrastructure\Govori.Infrastructure.csproj" />
    <!-- Construct CatalogService directly to drive TaskIndex/NeedsPremium through real EF/SQL. -->
    <ProjectReference Include="..\..\src\Modules\Govori.Catalog\Govori.Catalog.csproj" />
    <!-- Construct MinioObjectStorage directly against govori-net MinIO (object-storage round-trip). -->
    <ProjectReference Include="..\..\src\Govori.Platform\Govori.Platform.csproj" />
    <!-- Drive the grading pipeline (AssessmentService / IGradingQueue) with Fake providers. -->
    <ProjectReference Include="..\..\src\Modules\Govori.Assessment\Govori.Assessment.csproj" />
    <!-- Construct EngagementService directly to drive the worker-side award/streak/SRS-schedule paths
         (no HTTP route) through real EF/SQL, alongside the leaderboard/review/notification endpoints. -->
    <ProjectReference Include="..\..\src\Modules\Govori.Engagement\Govori.Engagement.csproj" />
    <!-- Construct AppSettingsService/AppSettingsCache directly to drive the tri-state + ~30s cache
         (docs/07 §3.7) through real EF/SQL without waiting real seconds. -->
    <ProjectReference Include="..\..\src\Modules\Govori.Administration\Govori.Administration.csproj" />
    <!-- Billing (Faza 6.6): construct BillingService directly with a CONFIGURED fake
         IPaymentProvider, so the idempotency guard and the verified-callback grant — code the
         shipped stub refuses before ever reaching — are actually executed against real SQL. -->
    <ProjectReference Include="..\..\src\Modules\Govori.Billing\Govori.Billing.csproj" />
  </ItemGroup>

</Project>
