# Govori — PRODUCTION nginx: TLS terminator, SPA host, and the single public
# entry point for the API, the SignalR hub and the audio bucket.
#
# This is a TEMPLATE, not a config. The nginx image's entrypoint runs
# `envsubst` over /etc/nginx/templates/*.template into /etc/nginx/conf.d/, with
# NGINX_ENVSUBST_FILTER=^GOVORI_ so ONLY the ${GOVORI_*} names below are
# substituted — nginx's own $host / $uri / $scheme survive untouched.
#
# Substituted at container start (set in docker-compose.prod.yml):
#   ${GOVORI_SERVER_NAME}   apex domain, e.g. govorim.uz
#   ${GOVORI_S3_BUCKET}     audio bucket name — MUST equal S3_BUCKET in .env
#   ${GOVORI_HSTS_MAX_AGE}  seconds; 0 disables the HSTS header
#   ${GOVORI_CSP_HEADER}    Content-Security-Policy (enforce, the default) or
#                           Content-Security-Policy-Report-Only — see "App CSP"
#
# The bucket appears in a location PATH, and nginx cannot read an environment
# variable there. Hardcoding it is the failure this template exists to prevent:
# rename the bucket in .env and every recording 404s while every page still
# renders perfectly, so it reads as "the audio feature broke", not "a config
# drifted".

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ── App CSP ──────────────────────────────────────────────────────────────────
# The one place the app's Content-Security-Policy is written; every location that
# re-declares its headers (see "Security headers") sends this variable. A map with a
# constant key is just nginx's way to declare a string once at http level.
#
# Derived from what the built SPA actually loads, not from a template:
#   script-src 'self'   index.html has ONE external module script and no inline
#                       <script>; Vite's modulepreload polyfill lives inside the entry
#                       chunk. No eval/new Function in the bundle. Nothing third-party:
#                       no analytics, no Google/Telegram sign-in widget (Telegram login
#                       is a t.me deep link — a navigation, not a script).
#   style-src 'self'    one CSS file. React `style={{…}}` props are applied through the
#                       CSSOM (el.style.x = …), which CSP does not govern, so no
#                       'unsafe-inline'.
#   img-src  data:      CSS mask-image icons are data: SVGs; blob: = local previews.
#   media-src blob:     the Recorder plays back the just-recorded Blob before upload.
#   img/media/connect https://${GOVORI_SERVER_NAME}
#                       presigned MinIO URLs are minted against S3_PUBLIC_URL (the apex
#                       domain) — same-origin on the apex, cross-origin from www.
#   connect-src wss://  the SignalR hub at /hubs/ (the SPA has no hub client yet; listed
#                       so wiring one does not start with a CSP outage). Older Safari does
#                       not let 'self' cover wss:, so the origins are spelled out.
#   font-src 'self'     Onest / JetBrains Mono are self-hosted woff2.
#   frame-ancestors 'self' mirrors X-Frame-Options; object-src/base-uri/form-action
#                       close the classic injection gadgets.
#
# Adding an origin: append it to the ONE directive that needs it (e.g. a CDN for audio →
# media-src), re-run the CSP check in docs/09-DOCKER.md, deploy. Never widen default-src
# and never add 'unsafe-inline' / 'unsafe-eval' to script-src — the auth tokens live in
# localStorage, and this header is the backstop that keeps an HTML-injection bug from
# becoming a session theft.
map $host $govori_csp {
    default "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://${GOVORI_SERVER_NAME}; media-src 'self' blob: https://${GOVORI_SERVER_NAME}; font-src 'self'; connect-src 'self' https://${GOVORI_SERVER_NAME} wss://${GOVORI_SERVER_NAME} wss://www.${GOVORI_SERVER_NAME}; worker-src 'self'; manifest-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests";
}

upstream govori_api {
    server api:8080;
    keepalive 32;
}

upstream govori_minio {
    server minio:9000;
    keepalive 16;
}

# ─────────────────────────── :80 — ACME + redirect ───────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name ${GOVORI_SERVER_NAME} www.${GOVORI_SERVER_NAME} _;

    # certbot --webroot drops its challenge files here (shared volume with the
    # certbot service). This location MUST stay above the redirect: Let's Encrypt
    # follows redirects for HTTP-01, but a renewal that depends on the very
    # certificate it is renewing is a bootstrap problem waiting for the first
    # expiry.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        access_log off;
    }

    # Container healthcheck. Plain HTTP on the loopback so `up -d` does not wait on
    # a certificate that certbot has not issued yet.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ─────────────────────────────── :443 — the app ──────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${GOVORI_SERVER_NAME} www.${GOVORI_SERVER_NAME} _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Renewals can arrive on :443 too.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        access_log off;
    }

    # ── Security headers ─────────────────────────────────────────────────────
    # `always` matters: without it nginx omits these on 4xx/5xx, i.e. exactly the
    # responses an attacker is trying to provoke.
    #
    # THEY ARE REPEATED IN THREE LOCATIONS BELOW ON PURPOSE. nginx's add_header does
    # not merge: the moment a location declares one add_header of its own, it
    # inherits NONE of the server-level ones. So the bucket location (its own CSP) and
    # the two that need their own Cache-Control (/assets/ and the SPA fallback) would silently serve every
    # page and every script with no nosniff, no HSTS and no frame protection —
    # which is most of the traffic, and nothing anywhere reports it.
    #
    # HSTS is deliberately last-resort-reversible: it is emitted only when
    # GOVORI_HSTS_MAX_AGE is non-zero, and it does NOT carry `preload`. Preload is
    # a one-way door — browsers ship the list in their binary and removal takes
    # months — which is the wrong commitment for a domain three days into HTTPS.
    # Set GOVORI_HSTS_MAX_AGE=300 for the first day if you want an escape hatch.
    add_header Strict-Transport-Security "max-age=${GOVORI_HSTS_MAX_AGE}; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "SAMEORIGIN" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    # microphone=(self) is load-bearing, not boilerplate: the whole product is a
    # speaking app. A blanket `microphone=()` would break recording everywhere.
    add_header Permissions-Policy        "microphone=(self), camera=(), geolocation=(), payment=()" always;
    # The app CSP ($govori_csp, defined at the top). The header NAME is an env switch, so
    # enforce ↔ report-only is one line in .env plus a container restart, not an edit
    # here: GOVORI_CSP_HEADER=Content-Security-Policy-Report-Only. /api/ responses also
    # carry the api's own `default-src 'none'` (Govori.Api/Startup/SecurityHeaders.cs);
    # two CSP headers intersect, so the stricter one still governs the JSON.
    # NOT in the bucket location: that one has its own `sandbox` policy.
    add_header ${GOVORI_CSP_HEADER} $govori_csp always;

    # ── Compression ──────────────────────────────────────────────────────────
    # gzip only: stock nginx has no brotli module, and adding one means building a
    # custom image. gzip on the JS bundle is worth ~70%; brotli would add ~15
    # points on top of that and is not worth a bespoke nginx on cutover night.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json
               image/svg+xml application/xml application/wasm font/woff2;

    # Audio answers are small; teacher-uploaded video questions are not.
    client_max_body_size 200m;
    client_body_timeout 120s;

    root /usr/share/nginx/html;
    index index.html;

    # ── Client address ───────────────────────────────────────────────────────
    # Every proxied location below SETS X-Forwarded-For to $remote_addr; none
    # appends with $proxy_add_x_forwarded_for. This nginx is the edge — the droplet
    # has no load balancer in front of it — so an X-Forwarded-For arriving from
    # the internet is whatever the client chose to type. Appending would forward
    # that claim, and the API keys every per-IP rate limit (OTP sends, the
    # public placement) on the client address: one forged header per
    # request and each of those limits is gone. The API reads the LAST hop as a
    # second line of defence (Govori.Api/RateLimiting/RateLimitIdentity.cs), but
    # this line is the first. If a CDN or load balancer is ever put in front of
    # this server, switch to the realip module (set_real_ip_from <its ranges>)
    # rather than back to appending.

    # ── REST API ─────────────────────────────────────────────────────────────
    location /api/ {
        proxy_pass http://govori_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;   # overwrite — see "Client address"
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        # Audio submissions stream straight through instead of landing in a temp
        # file first; buffering a 30 MB upload to disk on a small droplet is how
        # /var/lib/nginx fills up.
        proxy_request_buffering off;
    }

    # ── SignalR hub — the realtime half of Govori.Realtime ───────────────────
    # Without the Upgrade/Connection pair nginx answers the WebSocket handshake
    # with a 400 and SignalR quietly falls back to long polling: grading progress
    # still arrives, just late and at several times the request cost. It looks like
    # "the app is slow", never like "the proxy is misconfigured".
    location /hubs/ {
        proxy_pass http://govori_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;   # overwrite — see "Client address"
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # ── Audio / avatars → MinIO ──────────────────────────────────────────────
    # The api mints presigned URLs against S3_PUBLIC_URL (= https://this host), so
    # the browser fetches https://<domain>/<bucket>/<key>. SigV4 signs the Host
    # header, which is why the request has to arrive here rather than at a
    # published MinIO port — and why S3_PUBLIC_URL and this location must name the
    # same origin.
    location /${GOVORI_S3_BUCKET}/ {
        proxy_pass http://govori_minio;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # Host must be forwarded verbatim: the presigned signature covers it.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;   # overwrite — see "Client address"
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_request_buffering off;
        proxy_buffering off;
        client_max_body_size 200m;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        # Whatever is in the bucket must never run as a page on THIS origin. Objects are
        # served from the app's own domain (see above), and the app keeps its tokens in
        # localStorage — so an object stored as text/html or image/svg+xml would be a
        # stored XSS with the session of whoever opened the link. The api allow-lists what
        # it stores (PracticeService, CatalogService, AuthService); `sandbox` is the second
        # wall: even a document that got in anyway renders in an opaque origin with no
        # scripts. It changes nothing for <audio>/<img>/<video>, which ignore a resource's
        # CSP. The server-level headers are repeated because add_header here drops them.
        # Students' recordings: the browser may keep them, a shared cache (Cloudflare
        # caches .webm/.mp3/.mp4 by extension) may not.
        add_header Cache-Control             "private" always;
        add_header Content-Security-Policy   "sandbox; default-src 'none'" always;
        add_header Strict-Transport-Security "max-age=${GOVORI_HSTS_MAX_AGE}; includeSubDomains" always;
        add_header X-Content-Type-Options    "nosniff" always;
        add_header X-Frame-Options           "SAMEORIGIN" always;
        add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy        "microphone=(self), camera=(), geolocation=(), payment=()" always;
    }

    # ── Static assets ────────────────────────────────────────────────────────
    # Vite content-hashes everything under /assets/, so a year is safe and a new
    # deploy invalidates by filename.
    location /assets/ {
        access_log off;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        # Re-declared, not duplicated by accident — see the note above add_header
        # in the server block.
        add_header Strict-Transport-Security "max-age=${GOVORI_HSTS_MAX_AGE}; includeSubDomains" always;
        add_header X-Content-Type-Options    "nosniff" always;
        add_header X-Frame-Options           "SAMEORIGIN" always;
        add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy        "microphone=(self), camera=(), geolocation=(), payment=()" always;
        add_header ${GOVORI_CSP_HEADER} $govori_csp always;
    }

    # The build manifest is a build artefact, not a page asset. It is harmless but
    # it maps the whole chunk graph; nothing in the browser asks for it.
    location = /.vite/manifest.json { return 404; }

    # default_type rather than add_header: an add_header here would drop every
    # inherited security header from this response for no reason.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Readiness for an EXTERNAL uptime monitor: Postgres, Redis and object storage, each
    # probed with a short deadline. /api/ping only proves nginx and the api process are up;
    # this is the one that goes red when the api is up but cannot serve a request. The
    # api answers with the status word alone (Healthy/Unhealthy), never a probe's detail.
    location = /health/ready {
        access_log off;
        proxy_pass http://govori_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_read_timeout 15s;
    }

    # ── Root-level public files (frontend/public/) ───────────────────────────
    # Exact names, =404 when missing: a typo'd or not-yet-shipped /favicon.ico must be a
    # 404, not index.html served as image/x-icon (crawlers cache that). A regex rather than
    # a `^/[^/]+\.png$`-style catch-all, because a regex location outranks the bucket's
    # prefix location and a broad pattern would hijack /<bucket>/x.png. No add_header
    # here, so the server-level security headers (CSP included) are inherited intact.
    location ~ ^/(robots\.txt|favicon\.(ico|svg)|favicon-32\.png|apple-touch-icon\.png|icon-512\.png|og-image\.png)$ {
        try_files $uri =404;
        expires 1d;
    }
    # nginx 1.27's mime.types has no .webmanifest (it would go out as
    # application/octet-stream). An empty `types {}` here, not a `types` line in the
    # server block — that would REPLACE the whole mime map for every response.
    location = /manifest.webmanifest {
        types { }
        default_type application/manifest+json;
        try_files $uri =404;
        expires 1d;
    }

    # ── SPA fallback ─────────────────────────────────────────────────────────
    # index.html carries no content hash, so it must never be cached: otherwise a
    # deploy ships new /assets/ that the stale index.html never references, and
    # users sit on the old build until they hard-refresh.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        # Link-preview tags need ABSOLUTE URLs (og:url, og:image). index.html ships them
        # as https://govorim.uz; this points them at the configured domain instead, so a
        # different GOVORI_SERVER_NAME needs no rebuild. Only text/html is filtered.
        sub_filter 'https://govorim.uz/' 'https://${GOVORI_SERVER_NAME}/';
        sub_filter_once off;
        # Re-declared — see the note above add_header in the server block. This is
        # the location that serves every HTML page, so losing the headers here
        # would mean losing them where they matter most — the CSP above all.
        add_header Strict-Transport-Security "max-age=${GOVORI_HSTS_MAX_AGE}; includeSubDomains" always;
        add_header X-Content-Type-Options    "nosniff" always;
        add_header X-Frame-Options           "SAMEORIGIN" always;
        add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy        "microphone=(self), camera=(), geolocation=(), payment=()" always;
        add_header ${GOVORI_CSP_HEADER} $govori_csp always;
    }
}
