# ─────────────────────────────────────────────────────────────────────────────
# Govori production .env — the checklist for docker-compose.prod.yml.
#
#   cp deploy/env.prod.example .env       # ON THE DROPLET, next to the compose file
#   chmod 600 .env
#   $EDITOR .env
#
# This file names KEYS ONLY. Every value marked REQUIRED must be filled in or
# `docker compose -f docker-compose.prod.yml config` refuses to run — which is the
# design: a production stack that boots with a default password is worse than one
# that does not boot.
#
# Where the values come from:
#   • The old stack's .env, saved by deploy/backup-prod.sh as prod-backup/<ts>/env.txt
#   • prod-backup/<ts>/manifest.txt for the container and volume names
#   • The AI provider consoles, only for keys you are adding rather than carrying over
#
# Verify before `up`:
#   docker compose -f docker-compose.prod.yml config >/dev/null && echo "env complete"
# ─────────────────────────────────────────────────────────────────────────────

# ── Image tag — REQUIRED ─────────────────────────────────────────────────────
# The commit being deployed. This tag IS the application rollback: the previous
# image stays on the disk, so going back is one `up -d` with the old value and no
# rebuild. Never `latest`.
#   IMAGE_TAG=$(git rev-parse --short HEAD)
IMAGE_TAG=

# ── Domain — REQUIRED ────────────────────────────────────────────────────────
GOVORI_SERVER_NAME=govorim.uz
# Seconds. Start at 300 for the first day so a TLS mistake is recoverable, then
# raise to 31536000 once HTTPS has been stable for 24h. `preload` is deliberately
# never sent — it is a one-way door.
GOVORI_HSTS_MAX_AGE=300

# ── Database — REQUIRED ──────────────────────────────────────────────────────
# COPY THESE FROM THE OLD STACK'S .env. The .NET stack starts against the SAME
# Postgres volume; a different password here just means the api cannot connect,
# but a different POSTGRES_DB means it connects to an empty database and EF
# happily creates a fresh schema next to the real one.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── Object storage / MinIO — REQUIRED ────────────────────────────────────────
# Also from the old stack's .env: these are the credentials the EXISTING volume
# was initialised with, and MinIO will not read its own data with different ones.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Must match the bucket the existing audio is already in, and it is substituted
# into the nginx location that proxies it (deploy/nginx/govori-prod.conf.template).
S3_BUCKET=
# The public origin presigned URLs are signed for. SigV4 covers the host, so this
# has to be the address the BROWSER uses — https, apex domain, no trailing slash.
S3_PUBLIC_URL=https://govorim.uz
S3_REGION=us-east-1
# `off` keeps the MinIO admin console from starting. It has no published port
# either way; this removes it as a target entirely.
MINIO_BROWSER=off

# ── Auth — REQUIRED ──────────────────────────────────────────────────────────
# THE SINGLE MOST IMPORTANT LINE IN THIS FILE. Access tokens are HS256-signed with
# it. Carry the EXISTING value across verbatim and every logged-in user stays
# logged in; change it and all ~50 are silently signed out with no error anywhere.
SECRET_KEY=

# ── Optional integrations ────────────────────────────────────────────────────
# Empty is a supported state everywhere below.

# Google Sign-In. Also baked into the frontend bundle at BUILD time, so changing
# it requires `docker compose -f docker-compose.prod.yml build web`, not a restart.
GOOGLE_CLIENT_ID=

# ── Phone-OTP over Telegram — EFFECTIVELY REQUIRED ───────────────────────────
# Both set → real delivery via the bot. Either one empty → the Api selects the DEV
# OTP sender, whose fixed code 000000 logs ANYONE in as ANY phone number. That is
# not a degraded mode, it is no authentication at all, so a Production host
# REFUSES TO START without both (Govori.Api/Startup/ProductionSecrets.cs).
# Create the bot with @BotFather; the username goes in without the @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Cross-origin policy. LEAVE EMPTY: nginx serves the SPA and proxies /api from the
# same origin, so no CORS headers are needed. A wildcard here would let any website
# read a logged-in user's data — the Api refuses to boot on one rather than
# silently downgrading.
BACKEND_CORS_ORIGINS=

# Escape hatch for the boot gate above — for reproducing a production issue on a
# laptop, never for this droplet. Setting it to `true` on govorim.uz turns the
# refusal-to-start into an authentication bypass nobody will notice.
GOVORI_ALLOW_INSECURE_PRODUCTION=

# ── Admin-overridable settings (AI + content switches) ───────────────────────
# STARTING values only. Each resolves as `app_settings row → this env var →
# built-in default`, so an admin rotates a key from the panel without a redeploy,
# and clearing it there falls back to whatever is set here. An unset AI key means
# that backend is skipped and the chain moves on — a supported state.
#
# This list is the Spec map in Govori.Administration/AppSettingsService.cs, in
# full and on purpose. A key the panel can write but nothing forwards has no
# environment default at all, so the line you fill in below would do nothing
# while looking like it does.
LLM_PROVIDER=
GRADER_CHAIN=
STT_CHAIN=
STT_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_GRADER_MODEL=
WHISPER_MODEL=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
ORTHOEPY_ENABLED=
TG_SUPPORT_URL=
TG_CHANNEL_URL=

# ── Feature flags (Faza 6) ───────────────────────────────────────────────────
# Ship OFF. Flip them from app_settings, not from here — a flag that needs a
# redeploy to turn off is not a kill switch.
REVIEW_DRILL_ENABLED=
ROLEPLAY_ENABLED=
ROLEPLAY_MAX_TURNS=
ROLEPLAY_DAILY_TURNS=

# ── Product / auth tunables (read once at boot) ──────────────────────────────
# LEAVE THESE BLANK unless you mean to change one. Blank here is safe because
# docker-compose.prod.yml substitutes the code's own default when the line is
# empty — a numeric setting that reached the app as an empty string would fail
# the int conversion and the container would not start.
#
# FREE_TASKS_PER_MODULE is POSITIONAL: the first N tasks of every public module
# are free (default 3). It does not count a student's attempts, so there is no
# per-account attempt quota to configure — an env var named after one is read by
# nothing.
FREE_TASKS_PER_MODULE=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=
EMAIL_OTP_LENGTH=
EMAIL_OTP_TTL_SEC=
EMAIL_OTP_MAX_ATTEMPTS=
EMAIL_VERIFY_TOKEN_EXPIRE_MINUTES=

# ── Ops ──────────────────────────────────────────────────────────────────────
GOVORI_RATELIMIT_BACKEND=redis
# There is deliberately no SENTRY_DSN / LOG_LEVEL / LOG_JSON / STUDENT_UPLOAD_QUOTA
# here. They belonged to the Python stack and NOTHING in backend-dotnet reads them
# (grepped, zero references). A dead knob in a production env file is worse than a
# missing one: it is a lever someone pulls during an incident, believing it did
# something.

# ── Volumes — READ THE MANIFEST BEFORE FILLING THESE IN ──────────────────────
# pgdata and miniodata are declared `external: true`, so compose will NOT create
# them: a wrong name is "volume not found" and nothing starts, instead of an empty
# database that boots and looks healthy with everyone's data missing.
#
# Take the real names from prod-backup/<ts>/manifest.txt (the `--- volumes ---`
# section). On the live droplet these are the volumes the OLD stack is using —
# that is the whole point, the .NET stack adopts the same data.
PG_VOLUME=govori-pgdata
MINIO_VOLUME=govori-miniodata
# Rebuildable (OTP + SignalR backplane); compose creates this one itself.
REDIS_VOLUME=govori-prod-redisdata
NETWORK_NAME=govori-prod-net

# ── Resource limits ──────────────────────────────────────────────────────────
# Defaults suit a 2 GB droplet. Check `--- memory ---` in the manifest first: on a
# 1 GB box halve the two .NET services and make sure a swapfile exists, or the
# kernel will pick a victim for you and it will be Postgres.
DB_MEM_LIMIT=512m
REDIS_MEM_LIMIT=128m
REDIS_MAXMEMORY=96mb
MINIO_MEM_LIMIT=384m
API_MEM_LIMIT=640m
WORKER_MEM_LIMIT=768m
WEB_MEM_LIMIT=128m
